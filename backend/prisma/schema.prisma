generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAB_STAFF
  LECTURER
  STUDENT
}

// Technical subtype vocabulary. Resource.category is the assignment-level taxonomy.
enum ResourceType {
  ROOM         @map("room")
  GPU_SERVER   @map("gpu_server")
  RASPBERRY_PI @map("raspberry_pi")
  UAV          @map("uav")
  CAMERA       @map("camera")
  KIT          @map("kit")
  MATERIAL     @map("material")
  OTHER        @map("other")
}

enum ResourceCategory {
  ROOM
  EQUIPMENT
  MACHINE
  EXPERIMENT_KIT
  MATERIAL
}

// Authoritative operational state. Reservations are derived from time-window bookings.
enum OperationalStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  CALIBRATION
  BROKEN
  RETIRED
  OFFLINE
}

// Compatibility only. Do not use reserved as a physical operational state.
enum ResourceStatus {
  available
  reserved
  in_use
  maintenance
  offline
}

enum BookingState {
  bookable
  restricted
  non_bookable
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_OUT
  RETURNED
  COMPLETED
  REJECTED
  CANCELLED
}

enum BookingOutcome {
  NO_SHOW
}

enum MaintenanceKind {
  maintenance
  calibration
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum UsageAction {
  REQUEST
  APPROVE
  REJECT
  CHECK_OUT
  CHECK_IN
  RETURN
  COMPLETE
  STATUS_CHANGE
  TELEMETRY
  CANCEL
  INCIDENT_REPORTED
  NO_SHOW
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
}

enum NotificationType {
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_UPCOMING
  RETURN_REMINDER
}

enum NotificationSeverity {
  info
  success
  warning
  danger
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ShipmentStatus {
  pending
  picking
  delivering
  delivered
  cancelled
  returned
}

enum IncidentStatus {
  reported
  triaged
  assigned
  investigating
  resolved
  verified
  closed
}

enum MonitoringAlertSeverity {
  WARNING
  CRITICAL
}

enum MonitoringAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum CertificationStatus {
  pending
  active
  expired
  revoked
}

// IDs are generated by the application as UUID v4 values before persistence.
// Existing non-UUID text IDs remain valid; the database intentionally has no ID defaults.
model Campus {
  id        String     @id
  name      String
  code      String     @unique
  address   String?
  createdAt DateTime   @default(now())
  buildings Building[]

  @@map("campuses")
}

model Building {
  id           String       @id
  campusId     String
  name         String
  code         String       @unique
  createdAt    DateTime     @default(now())
  campus       Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  laboratories Laboratory[]

  @@index([campusId])
  @@map("buildings")
}

model Laboratory {
  id                  String                         @id
  buildingId          String
  name                String
  code                String                         @unique
  description         String?
  capacity            Int                            @default(0)
  openingTime         String?
  closingTime         String?
  isActive            Boolean                        @default(true)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  building            Building                       @relation(fields: [buildingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources           Resource[]
  labPolicy           LabPolicy?
  knowledgeDocuments  KnowledgeDocument[]
  staffAssignments    UserLabAssignment[]
  telemetrySources    TelemetrySource[]
  monitoringThreshold LaboratoryMonitoringThreshold?
  monitoringAlerts    MonitoringAlert[]
  cameras             Camera[]
  cameraAccessAudits  CameraAccessAudit[]

  @@index([buildingId])
  @@map("laboratories")
}

model LabPolicy {
  id                    String     @id
  laboratoryId          String     @unique
  maxBookingMinutes     Int        @default(480)
  minBookingMinutes     Int        @default(15)
  maxAdvanceBookingDays Int        @default(30)
  checkInGraceMinutes   Int        @default(20)
  requiresApproval      Boolean    @default(false)
  allowWeekend          Boolean    @default(false)
  workDayStartHour      Int        @default(8)
  workDayEndHour        Int        @default(18)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  laboratory            Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("lab_policies")
}

model User {
  id                           String                @id
  email                        String                @unique
  fullName                     String
  role                         Role
  passwordHash                 String
  studentId                    String?
  department                   String?
  phone                        String?
  isActive                     Boolean               @default(true)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @default(now()) @updatedAt
  bookings                     Booking[]             @relation("Requester")
  approvals                    Booking[]             @relation("Approver")
  maintenanceWindows           MaintenanceWindow[]   @relation("MaintenanceCreator")
  usageLogs                    UsageLog[]
  notifications                Notification[]
  certifications               UserCertification[]
  reportedIncidents            Incident[]            @relation("IncidentReporter")
  assignedIncidents            Incident[]            @relation("IncidentAssignee")
  payments                     PaymentTransaction[]
  shipments                    ShipmentOrder[]
  requirements                 ResourceRequirement[]
  behaviorScore                UserBehaviorScore?
  labAssignments               UserLabAssignment[]
  acknowledgedMonitoringAlerts MonitoringAlert[]     @relation("MonitoringAlertAcknowledgement")
  cameraAccessAudits           CameraAccessAudit[]

  @@map("users")
}

model Resource {
  id                String            @id
  laboratoryId      String?
  code              String            @unique
  name              String
  subtype           ResourceType      @map("type")
  category          ResourceCategory?
  location          String
  operationalStatus OperationalStatus @default(AVAILABLE)
  bookingState      BookingState      @default(bookable)
  /// Compatibility field retained unchanged until the authoritative-field cutover.

  status           ResourceStatus @default(available)
  ownerTeam        String         @default("")
  capacity         Int            @default(1)
  requiresApproval Boolean        @default(false)
  serialNumber     String?
  manufacturer     String?
  model            String?
  purchaseDate     DateTime?
  warrantyExpiry   DateTime?
  description      String?
  specs            Json           @default("{}")

  version              Int                          @default(0)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @default(now()) @updatedAt
  laboratory           Laboratory?                  @relation(fields: [laboratoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bookings             Booking[]
  maintenanceWindows   MaintenanceWindow[]
  usageLogs            UsageLog[]
  telemetrySamples     TelemetrySample[]
  capabilities         ResourceCapability[]
  statusHistory        ResourceStatusHistory[]
  trainingRequirements TrainingRequirement[]
  incidents            Incident[]
  knowledgeDocuments   KnowledgeDocument[]
  shipments            ShipmentOrder[]
  allocations          ResourceAllocation[]
  telemetrySources     TelemetrySource[]
  monitoringThreshold  ResourceMonitoringThreshold?
  monitoringAlerts     MonitoringAlert[]
  cameras              Camera[]
  cameraAccessAudits   CameraAccessAudit[]

  @@index([laboratoryId])
  @@index([operationalStatus])
  @@index([bookingState])
  @@map("resources")
}

model ResourceCapability {
  id         String   @id
  resourceId String
  key        String
  value      String
  unit       String?
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([resourceId, key])
  @@index([resourceId])
  @@map("resource_capabilities")
}

model ResourceStatusHistory {
  id          String            @id
  resourceId  String
  fromStatus  OperationalStatus
  toStatus    OperationalStatus
  reason      String?
  changedById String?
  createdAt   DateTime          @default(now())
  resource    Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([resourceId, createdAt])
  @@map("resource_status_history")
}

model TrainingCourse {
  id             String                @id
  name           String
  code           String                @unique
  description    String?
  durationHours  Float?
  isRequired     Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  requirements   TrainingRequirement[]
  certifications UserCertification[]

  @@map("training_courses")
}

model TrainingRequirement {
  id          String         @id
  resourceId  String
  courseId    String
  isMandatory Boolean        @default(true)
  createdAt   DateTime       @default(now())
  resource    Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([resourceId, courseId])
  @@index([resourceId])
  @@map("training_requirements")
}

model UserCertification {
  id         String              @id
  userId     String
  courseId   String
  status     CertificationStatus @default(active)
  issuedAt   DateTime            @default(now())
  expiresAt  DateTime?
  issuedById String?
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course     TrainingCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("user_certifications")
}

// PostgreSQL bookings_no_active_overlap is preserved externally; Prisma cannot model EXCLUDE.
model Booking {
  id                String                @id
  bookingCode       String?               @unique
  resourceId        String
  requestedById     String
  approvedById      String?
  title             String
  purpose           String
  startAt           DateTime
  endAt             DateTime
  status            BookingStatus         @default(PENDING_APPROVAL)
  priority          Int                   @default(0)
  notes             String?
  handoverCondition String?
  returnCondition   String?
  checkinDeadline   DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  approvedAt        DateTime?
  returnedAt        DateTime?
  completedAt       DateTime?
  outcome           BookingOutcome?
  outcomeAt         DateTime?
  idempotencyKey    String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  resource          Resource              @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy       User                  @relation("Requester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy        User?                 @relation("Approver", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usageLogs         UsageLog[]
  incidents         Incident[]
  payments          PaymentTransaction[]
  shipments         ShipmentOrder[]
  requirements      ResourceRequirement[]
  allocations       ResourceAllocation[]

  @@index([resourceId, startAt, endAt])
  @@index([requestedById])
  @@index([status])
  @@index([idempotencyKey])
  @@map("bookings")
}

model MaintenanceWindow {
  id          String            @id
  resourceId  String
  createdById String?
  kind        MaintenanceKind   @default(maintenance)
  status      MaintenanceStatus @default(scheduled)
  title       String
  startAt     DateTime
  endAt       DateTime
  notes       String?
  cost        Float?
  vendor      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resource    Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User?             @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([resourceId, startAt, endAt])
  @@index([status])
  @@map("maintenance_windows")
}

model Incident {
  id                String            @id
  resourceId        String
  bookingId         String?
  reportedById      String?
  assignedToId      String?
  telemetrySourceId String?
  telemetrySampleId String?
  monitoringAlertId String?           @unique
  severity          IncidentSeverity  @default(medium)
  status            IncidentStatus    @default(reported)
  category          String?
  title             String
  description       String
  detectedAt        DateTime          @default(now())
  resolvedAt        DateTime?
  resolution        String?
  provenance        Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  resource          Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking           Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportedBy        User?             @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo        User?             @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  telemetrySource   TelemetrySource?  @relation(fields: [telemetrySourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  telemetrySample   TelemetrySample?  @relation(fields: [telemetrySampleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  monitoringAlert   MonitoringAlert?  @relation("IncidentMonitoringAlert", fields: [monitoringAlertId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  comments          IncidentComment[]

  @@index([resourceId])
  @@index([status])
  @@index([reportedById])
  @@index([telemetrySourceId])
  @@index([telemetrySampleId])
  @@map("incidents")
}

model IncidentComment {
  id         String   @id
  incidentId String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([incidentId])
  @@map("incident_comments")
}

model UsageLog {
  id              String         @id
  resourceId      String
  bookingId       String?
  userId          String?
  actorType       AuditActorType @default(USER)
  actorRef        String?
  action          UsageAction
  fromStatus      BookingStatus?
  toStatus        BookingStatus?
  reason          String?
  metadata        Json           @default("{}")
  message         String
  messageKey      String?
  messageParams   Json           @default("{}")
  conditionBefore String?
  conditionAfter  String?
  ipAddress       String?
  createdAt       DateTime       @default(now())
  resource        Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([resourceId])
  @@index([bookingId])
  @@index([userId])
  @@map("usage_logs")
}

model Notification {
  id            String               @id
  userId        String
  type          NotificationType?
  title         String
  message       String
  titleKey      String?
  messageKey    String?
  messageParams Json                 @default("{}")
  severity      NotificationSeverity @default(info)
  channel       String               @default("in_app")
  readAt        DateTime?
  scheduledAt   DateTime?
  sentAt        DateTime?
  dedupeKey     String?              @unique
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, type, scheduledAt])
  @@map("notifications")
}

model TelemetrySample {
  id               String            @id
  resourceId       String
  sourceId         String?
  externalId       String?
  cpuPercent       Float?
  gpuPercent       Float?
  gpuMemoryPercent Float?
  ramPercent       Float?
  diskPercent      Float?
  temperatureC     Float?
  humidityPercent  Float?
  online           Boolean           @default(true)
  source           String            @default("agent")
  verifiedSignals  Json?
  sampledAt        DateTime          @default(now())
  resource         Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  telemetrySource  TelemetrySource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  monitoringAlerts MonitoringAlert[]
  incidents        Incident[]

  @@unique([sourceId, externalId])
  @@index([resourceId, sampledAt])
  @@index([sourceId, sampledAt])
  @@map("telemetry_samples")
}

model TelemetrySource {
  id               String            @id
  code             String            @unique
  name             String
  laboratoryId     String
  resourceId       String
  credentialSalt   String
  credentialHash   String
  isActive         Boolean           @default(true)
  reportedOnline   Boolean?
  lastSeenAt       DateTime?
  lastSampleAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  laboratory       Laboratory        @relation(fields: [laboratoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource         Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  samples          TelemetrySample[]
  monitoringAlerts MonitoringAlert[]
  incidents        Incident[]
  camera           Camera?

  @@unique([resourceId, code])
  @@index([laboratoryId, isActive])
  @@index([resourceId, isActive])
  @@map("telemetry_sources")
}

model LaboratoryMonitoringThreshold {
  id                   String     @id
  laboratoryId         String     @unique
  temperatureWarningC  Float?
  temperatureCriticalC Float?
  humidityMinPercent   Float?
  humidityMaxPercent   Float?
  staleMinutes         Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  laboratory           Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("laboratory_monitoring_thresholds")
}

model ResourceMonitoringThreshold {
  id                   String   @id
  resourceId           String   @unique
  temperatureWarningC  Float?
  temperatureCriticalC Float?
  humidityMinPercent   Float?
  humidityMaxPercent   Float?
  staleMinutes         Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resource             Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("resource_monitoring_thresholds")
}

model MonitoringAlert {
  id                String                  @id
  activeDedupeKey   String?                 @unique
  conditionKey      String
  sourceId          String
  resourceId        String
  laboratoryId      String
  sampleId          String
  ruleCode          String
  severity          MonitoringAlertSeverity
  status            MonitoringAlertStatus   @default(OPEN)
  message           String
  observedValue     Float?
  thresholdSnapshot Json                    @default("{}")
  openedAt          DateTime                @default(now())
  lastObservedAt    DateTime                @default(now())
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  resolution        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  source            TelemetrySource         @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource          Resource                @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  laboratory        Laboratory              @relation(fields: [laboratoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sample            TelemetrySample         @relation(fields: [sampleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acknowledgedBy    User?                   @relation("MonitoringAlertAcknowledgement", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  incident          Incident?               @relation("IncidentMonitoringAlert")

  @@index([laboratoryId, status, openedAt])
  @@index([resourceId, status])
  @@index([sourceId, status])
  @@index([conditionKey])
  @@map("monitoring_alerts")
}

model Camera {
  id                String              @id
  code              String              @unique
  name              String
  laboratoryId      String
  resourceId        String
  telemetrySourceId String?             @unique
  enabled           Boolean             @default(false)
  endpointUrl       String?
  status            String              @default("NOT_CONFIGURED")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  laboratory        Laboratory          @relation(fields: [laboratoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource          Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  telemetrySource   TelemetrySource?    @relation(fields: [telemetrySourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  accessAudits      CameraAccessAudit[]

  @@index([laboratoryId, enabled])
  @@index([resourceId])
  @@map("cameras")
}

model CameraAccessAudit {
  id           String     @id
  cameraId     String
  resourceId   String
  laboratoryId String
  actorId      String
  purpose      String
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  outcome      String
  detail       String?
  camera       Camera     @relation(fields: [cameraId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([cameraId, startedAt])
  @@index([actorId, startedAt])
  @@index([laboratoryId, startedAt])
  @@map("camera_access_audits")
}

model KnowledgeDocument {
  id           String           @id
  resourceId   String?
  laboratoryId String?
  title        String
  sourceType   String           @default("manual")
  fileName     String?
  fileUrl      String?
  version      String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  resource     Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  laboratory   Laboratory?      @relation(fields: [laboratoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  chunks       KnowledgeChunk[]

  @@index([resourceId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String @id
  documentId String
  chunkIndex Int
  content    String
  metadata   Json   @default("{}")

  embeddingJson String?           @db.Text
  createdAt     DateTime          @default(now())
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

model AiConversation {
  id        String      @id
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id
  conversationId String
  role           String
  content        String
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model PaymentTransaction {
  id               String        @id
  bookingId        String?
  userId           String
  txnRef           String        @unique
  amount           Float
  currency         String        @default("VND")
  provider         String        @default("vnpay")
  status           PaymentStatus @default(pending)
  bankCode         String?
  cardType         String?
  vnpResponseCode  String?
  vnpTransactionNo String?
  paymentUrl       String?       @db.Text
  paidAt           DateTime?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@map("payment_transactions")
}

model ShipmentOrder {
  id               String         @id
  bookingId        String?
  resourceId       String?
  userId           String
  trackingCode     String         @unique
  provider         String         @default("ghn")
  status           ShipmentStatus @default(pending)
  fee              Float          @default(0)
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  rawResponse      Json           @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resource         Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([trackingCode])
  @@map("shipment_orders")
}

model ResourceRequirement {
  id                   String               @id
  userId               String
  bookingId            String?
  resourceType         ResourceType         @default(GPU_SERVER)
  minVramGb            Int?                 @default(16)
  minComputeTflops     Float?
  requiredCapabilities Json                 @default("{}")
  durationMinutes      Int                  @default(120)
  deadline             DateTime?
  maxCostVnd           Float?
  priorityScore        Int                  @default(50)
  projectUrgency       String               @default("course_project")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  booking              Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  allocations          ResourceAllocation[]

  @@index([userId])
  @@index([bookingId])
  @@map("resource_requirements")
}

model ResourceAllocation {
  id                String               @id
  requirementId     String?
  bookingId         String?
  resourceId        String
  startAt           DateTime
  endAt             DateTime
  allocationStatus  String               @default("proposed")
  optimizationRunId String?
  totalScore        Float?               @default(0)
  energyScore       Float?               @default(0)
  fairnessScore     Float?               @default(0)
  healthScore       Float?               @default(0)
  explanation       Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  requirement       ResourceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  booking           Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resource          Resource             @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optimizationRun   OptimizationRun?     @relation(fields: [optimizationRunId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([resourceId, startAt, endAt])
  @@index([requirementId])
  @@index([bookingId])
  @@index([optimizationRunId])
  @@map("resource_allocations")
}

model PolicyVersion {
  id               String            @id
  policyType       String
  version          String            @default("2026.1")
  name             String
  effectiveFrom    DateTime          @default(now())
  effectiveTo      DateTime?
  configuration    Json              @default("{}")
  isActive         Boolean           @default(true)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  optimizationRuns OptimizationRun[]

  @@index([policyType, isActive])
  @@map("policy_versions")
}

model OptimizationRun {
  id               String                 @id
  algorithm        String
  algorithmVersion String                 @default("1.0")
  datasetVersion   String?
  policyVersionId  String?
  populationSize   Int?
  generations      Int?
  mutationRate     Float?
  crossoverRate    Float?
  objectiveWeights Json                   @default("{}")
  metricsSummary   Json                   @default("{}")
  runtimeMs        Int                    @default(0)
  createdAt        DateTime               @default(now())
  policyVersion    PolicyVersion?         @relation(fields: [policyVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  allocations      ResourceAllocation[]
  decisions        OptimizationDecision[]

  @@index([algorithm])
  @@index([policyVersionId])
  @@map("optimization_runs")
}

model OptimizationDecision {
  id               String          @id
  runId            String
  allocationId     String?
  objectiveVector  Json            @default("[]")
  paretoRank       Int             @default(1)
  crowdingDistance Float           @default(0)
  explanation      String?
  createdAt        DateTime        @default(now())
  optimizationRun  OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([runId])
  @@map("optimization_decisions")
}

model UserBehaviorScore {
  id               String             @id
  userId           String             @unique
  currentScore     Float              @default(100.0)
  lateCancelCount  Int                @default(0)
  noShowCount      Int                @default(0)
  quotaBreachCount Int                @default(0)
  cleanStreakDays  Int                @default(0)
  lastViolationAt  DateTime?
  updatedAt        DateTime           @default(now()) @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  logs             BehaviorEventLog[]

  @@index([userId])
  @@map("user_behavior_scores")
}

model BehaviorEventLog {
  id            String            @id
  scoreId       String
  eventType     String
  scoreDelta    Float
  previousScore Float
  newScore      Float
  reason        String
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now())
  score         UserBehaviorScore @relation(fields: [scoreId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([scoreId, createdAt])
  @@map("behavior_event_logs")
}

model UserLabAssignment {
  userId       String
  laboratoryId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, laboratoryId])
  @@index([laboratoryId])
  @@map("user_lab_assignments")
}
