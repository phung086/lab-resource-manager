generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  admin
  lab_staff
  lecturer
  student
}

enum ResourceType {
  room
  gpu_server
  raspberry_pi
  uav
  camera
  kit
  material
  other
}

/// Operational status của Equipment – biểu diễn trạng thái vật lý/vận hành
enum OperationalStatus {
  available
  in_use
  maintenance
  calibration
  broken
  retired
  offline
}

/// Trạng thái cũ của Resource – giữ để backward compat
enum ResourceStatus {
  available
  reserved
  in_use
  maintenance
  offline
}

/// Khả năng đặt lịch của Equipment (tách riêng khỏi operational_status)
enum BookingState {
  bookable
  restricted
  non_bookable
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled
  checked_out
  completed
  no_show
}

enum MaintenanceKind {
  maintenance
  calibration
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum UsageAction {
  request
  approve
  reject
  check_out
  check_in
  cancel
  status_change
  telemetry
  incident_reported
}

enum NotificationSeverity {
  info
  success
  warning
  danger
}

enum IncidentSeverity {
  low
  medium
  high
  critical
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ShipmentStatus {
  pending
  picking
  delivering
  delivered
  cancelled
  returned
}

enum IncidentStatus {
  reported
  triaged
  assigned
  investigating
  resolved
  verified
  closed
}

enum CertificationStatus {
  pending
  active
  expired
  revoked
}

// ─────────────────────────────────────────
// LOCATION HIERARCHY
// ─────────────────────────────────────────

model Campus {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  address     String?
  createdAt   DateTime   @default(now())
  buildings   Building[]

  @@map("campuses")
}

model Building {
  id          String       @id @default(uuid())
  campusId    String
  name        String
  code        String       @unique
  createdAt   DateTime     @default(now())
  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  laboratories Laboratory[]

  @@index([campusId])
  @@map("buildings")
}

model Laboratory {
  id            String      @id @default(uuid())
  buildingId    String
  name          String
  code          String      @unique
  description   String?
  capacity      Int         @default(0)
  openingTime   String?     // "08:00"
  closingTime   String?     // "18:00"
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  building      Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  resources     Resource[]
  labPolicy     LabPolicy?
  knowledgeDocuments KnowledgeDocument[]

  @@index([buildingId])
  @@map("laboratories")
}

model LabPolicy {
  id                    String    @id @default(uuid())
  laboratoryId          String    @unique
  maxBookingMinutes     Int       @default(480)
  minBookingMinutes     Int       @default(15)
  maxAdvanceBookingDays Int       @default(30)
  checkInGraceMinutes   Int       @default(20)
  requiresApproval      Boolean   @default(false)
  allowWeekend          Boolean   @default(false)
  workDayStartHour      Int       @default(8)
  workDayEndHour        Int       @default(18)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  laboratory            Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  @@map("lab_policies")
}

// ─────────────────────────────────────────
// USER / IDENTITY
// ─────────────────────────────────────────

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  fullName              String
  role                  Role
  passwordHash          String
  studentId             String?
  department            String?
  phone                 String?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  bookings              Booking[]             @relation("Requester")
  approvals             Booking[]             @relation("Approver")
  maintenanceWindows    MaintenanceWindow[]   @relation("MaintenanceCreator")
  usageLogs             UsageLog[]
  notifications         Notification[]
  certifications        UserCertification[]
  reportedIncidents     Incident[]            @relation("IncidentReporter")
  assignedIncidents     Incident[]            @relation("IncidentAssignee")
  payments              PaymentTransaction[]
  shipments             ShipmentOrder[]
  requirements          ResourceRequirement[]
  behaviorScore         UserBehaviorScore?

  @@map("users")
}

// ─────────────────────────────────────────
// RESOURCE (Equipment) – backward compat + nâng cao
// ─────────────────────────────────────────

model Resource {
  id                   String                   @id @default(uuid())
  laboratoryId         String?
  code                 String                   @unique
  name                 String
  type                 ResourceType
  location             String
  operationalStatus    OperationalStatus        @default(available)
  bookingState         BookingState             @default(bookable)
  /// Trường cũ giữ backward compat
  status               ResourceStatus           @default(available)
  ownerTeam            String                   @default("")
  capacity             Int                      @default(1)
  requiresApproval     Boolean                  @default(false)
  serialNumber         String?
  manufacturer         String?
  model                String?
  purchaseDate         DateTime?
  warrantyExpiry       DateTime?
  description          String?
  specs                Json                     @default("{}")
  /// Optimistic locking version
  version              Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  laboratory           Laboratory?              @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  bookings             Booking[]
  maintenanceWindows   MaintenanceWindow[]
  usageLogs            UsageLog[]
  telemetrySamples     TelemetrySample[]
  capabilities         ResourceCapability[]
  statusHistory        ResourceStatusHistory[]
  trainingRequirements TrainingRequirement[]
  incidents            Incident[]
  knowledgeDocuments   KnowledgeDocument[]
  shipments            ShipmentOrder[]
  allocations          ResourceAllocation[]

  @@index([laboratoryId])
  @@index([operationalStatus])
  @@index([bookingState])
  @@map("resources")
}

model ResourceCapability {
  id              String   @id @default(uuid())
  resourceId      String
  key             String   // e.g. "measurement_type", "accuracy", "range"
  value           String
  unit            String?
  createdAt       DateTime @default(now())
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, key])
  @@index([resourceId])
  @@map("resource_capabilities")
}

model ResourceStatusHistory {
  id              String            @id @default(uuid())
  resourceId      String
  fromStatus      OperationalStatus
  toStatus        OperationalStatus
  reason          String?
  changedById     String?
  createdAt       DateTime          @default(now())
  resource        Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, createdAt])
  @@map("resource_status_history")
}

// ─────────────────────────────────────────
// TRAINING & CERTIFICATION
// ─────────────────────────────────────────

model TrainingCourse {
  id              String                @id @default(uuid())
  name            String
  code            String                @unique
  description     String?
  durationHours   Float?
  isRequired      Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  requirements    TrainingRequirement[]
  certifications  UserCertification[]

  @@map("training_courses")
}

/// Thiết bị yêu cầu chứng chỉ nào để được đặt
model TrainingRequirement {
  id           String         @id @default(uuid())
  resourceId   String
  courseId     String
  isMandatory  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  resource     Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([resourceId, courseId])
  @@index([resourceId])
  @@map("training_requirements")
}

/// Chứng chỉ/kết quả đào tạo của từng user
model UserCertification {
  id           String              @id @default(uuid())
  userId       String
  courseId     String
  status       CertificationStatus @default(active)
  issuedAt     DateTime            @default(now())
  expiresAt    DateTime?
  issuedById   String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       TrainingCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("user_certifications")
}

// ─────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────

model Booking {
  id                String        @id @default(uuid())
  bookingCode       String?       @unique @default(cuid())
  resourceId        String
  requestedById     String
  approvedById      String?
  title             String
  purpose           String
  startAt           DateTime
  endAt             DateTime
  status            BookingStatus @default(pending)
  priority          Int           @default(0)
  notes             String?
  handoverCondition String?
  returnCondition   String?
  checkinDeadline   DateTime?
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  resource          Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  requestedBy       User          @relation("Requester", fields: [requestedById], references: [id])
  approvedBy        User?         @relation("Approver", fields: [approvedById], references: [id])
  usageLogs         UsageLog[]
  incidents         Incident[]
  payments          PaymentTransaction[]
  shipments         ShipmentOrder[]
  requirements      ResourceRequirement[]
  allocations       ResourceAllocation[]

  @@index([resourceId, startAt, endAt])
  @@index([requestedById])
  @@index([status])
  @@index([idempotencyKey])
  @@map("bookings")
}

// ─────────────────────────────────────────
// MAINTENANCE
// ─────────────────────────────────────────

model MaintenanceWindow {
  id          String            @id @default(uuid())
  resourceId  String
  createdById String?
  kind        MaintenanceKind   @default(maintenance)
  status      MaintenanceStatus @default(scheduled)
  title       String
  startAt     DateTime
  endAt       DateTime
  notes       String?
  cost        Float?
  vendor      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resource    Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([resourceId, startAt, endAt])
  @@index([status])
  @@map("maintenance_windows")
}

// ─────────────────────────────────────────
// INCIDENT MANAGEMENT
// ─────────────────────────────────────────

model Incident {
  id              String           @id @default(uuid())
  resourceId      String
  bookingId       String?
  reportedById    String
  assignedToId    String?
  severity        IncidentSeverity @default(medium)
  status          IncidentStatus   @default(reported)
  category        String?
  title           String
  description     String
  detectedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resource        Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reportedBy      User             @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo      User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments        IncidentComment[]

  @@index([resourceId])
  @@index([status])
  @@index([reportedById])
  @@map("incidents")
}

model IncidentComment {
  id          String   @id @default(uuid())
  incidentId  String
  authorId    String?
  content     String
  createdAt   DateTime @default(now())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_comments")
}

// ─────────────────────────────────────────
// USAGE LOG / AUDIT
// ─────────────────────────────────────────

model UsageLog {
  id              String      @id @default(uuid())
  resourceId      String
  bookingId       String?
  userId          String
  action          UsageAction
  message         String
  messageKey      String?
  messageParams   Json        @default("{}")
  conditionBefore String?
  conditionAfter  String?
  ipAddress       String?
  createdAt       DateTime    @default(now())
  resource        Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  booking         Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])

  @@index([resourceId])
  @@index([bookingId])
  @@index([userId])
  @@map("usage_logs")
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id            String               @id @default(uuid())
  userId        String
  type          String?
  title         String
  message       String
  titleKey      String?
  messageKey    String?
  messageParams Json                 @default("{}")
  severity      NotificationSeverity @default(info)
  channel       String               @default("in_app")
  readAt        DateTime?
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────
// TELEMETRY
// ─────────────────────────────────────────

model TelemetrySample {
  id               String   @id @default(uuid())
  resourceId       String
  cpuPercent       Float?
  gpuPercent       Float?
  gpuMemoryPercent Float?
  ramPercent       Float?
  diskPercent      Float?
  temperatureC     Float?
  online           Boolean  @default(true)
  source           String   @default("agent")
  sampledAt        DateTime @default(now())
  resource         Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, sampledAt])
  @@map("telemetry_samples")
}

// ─────────────────────────────────────────
// AI / KNOWLEDGE BASE
// ─────────────────────────────────────────

model KnowledgeDocument {
  id           String           @id @default(uuid())
  resourceId   String?
  laboratoryId String?
  title        String
  sourceType   String           @default("manual") // manual, sop, datasheet, faq, regulation
  fileName     String?
  fileUrl      String?
  version      String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  resource     Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  laboratory   Laboratory?      @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([resourceId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String            @id @default(uuid())
  documentId  String
  chunkIndex  Int
  content     String
  metadata    Json              @default("{}")
  /// Embedding stored as JSON array (will migrate to pgvector later)
  embeddingJson String?         @db.Text
  createdAt   DateTime          @default(now())
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // user | assistant | tool
  content        String
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ─────────────────────────────────────────
// INTEGRATIONS: PAYMENT & SHIPMENT
// ─────────────────────────────────────────

model PaymentTransaction {
  id               String        @id @default(uuid())
  bookingId        String?
  userId           String
  txnRef           String        @unique // vnp_TxnRef
  amount           Float
  currency         String        @default("VND")
  provider         String        @default("vnpay") // vnpay, payos, momo
  status           PaymentStatus @default(pending)
  bankCode         String?
  cardType         String?
  vnpResponseCode  String?
  vnpTransactionNo String?
  paymentUrl       String?       @db.Text
  paidAt           DateTime?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@map("payment_transactions")
}

model ShipmentOrder {
  id               String         @id @default(uuid())
  bookingId        String?
  resourceId       String?
  userId           String
  trackingCode     String         @unique // GHN tracking code
  provider         String         @default("ghn") // ghn, ghtk, viettelpost
  status           ShipmentStatus @default(pending)
  fee              Float          @default(0)
  senderAddress    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  rawResponse      Json           @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resource         Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([trackingCode])
  @@map("shipment_orders")
}

// ─────────────────────────────────────────
// PHASE 1: RESOURCE ORCHESTRATION & PROVENANCE (SMART LAB V2)
// ─────────────────────────────────────────

/// Đặc tả yêu cầu tài nguyên của người dùng (User requirements before physical allocation)
model ResourceRequirement {
  id                   String        @id @default(uuid())
  userId               String
  bookingId            String?
  resourceType         ResourceType  @default(gpu_server)
  minVramGb            Int?          @default(16)
  minComputeTflops     Float?
  requiredCapabilities Json          @default("{}") // e.g. {"cudaVersion": "12.2", "fp16": true}
  durationMinutes      Int           @default(120)
  deadline             DateTime?
  maxCostVnd           Float?
  priorityScore        Int           @default(50)
  projectUrgency       String        @default("course_project")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking              Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  allocations          ResourceAllocation[]

  @@index([userId])
  @@index([bookingId])
  @@map("resource_requirements")
}

/// Kết quả phân bổ tài nguyên vật lý từ bài toán tối ưu (Optimization allocation outcome)
model ResourceAllocation {
  id                String               @id @default(uuid())
  requirementId     String?
  bookingId         String?
  resourceId        String
  startAt           DateTime
  endAt             DateTime
  allocationStatus  String               @default("proposed") // proposed, confirmed, active, completed, cancelled
  optimizationRunId String?
  totalScore        Float?               @default(0)
  energyScore       Float?               @default(0)
  fairnessScore     Float?               @default(0)
  healthScore       Float?               @default(0)
  explanation       Json                 @default("{}") // Human-readable & factor decomposition
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  requirement       ResourceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  booking           Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resource          Resource             @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  optimizationRun   OptimizationRun?     @relation(fields: [optimizationRunId], references: [id], onDelete: SetNull)

  @@index([resourceId, startAt, endAt])
  @@index([requirementId])
  @@index([bookingId])
  @@index([optimizationRunId])
  @@map("resource_allocations")
}

/// Quản trị chính sách động theo phiên bản (Policy-driven dynamic architecture)
model PolicyVersion {
  id            String            @id @default(uuid())
  policyType    String            // "energy", "fairness", "priority", "maintenance", "safety"
  version       String            @default("2026.1")
  name          String
  effectiveFrom DateTime          @default(now())
  effectiveTo   DateTime?
  configuration Json              @default("{}") // Tariffs, weights, thresholds
  isActive      Boolean           @default(true)
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  optimizationRuns OptimizationRun[]

  @@index([policyType, isActive])
  @@map("policy_versions")
}

/// Lưu vết phiên chạy tối ưu hóa (Optimization Provenance)
model OptimizationRun {
  id               String                 @id @default(uuid())
  algorithm        String                 // "FIFO", "GREEDY", "GA", "NSGA2"
  algorithmVersion String                 @default("1.0")
  datasetVersion   String?
  policyVersionId  String?
  populationSize   Int?
  generations      Int?
  mutationRate     Float?
  crossoverRate    Float?
  objectiveWeights Json                   @default("{}")
  metricsSummary   Json                   @default("{}") // Conflicts, Energy cost, Pareto size
  runtimeMs        Int                    @default(0)
  createdAt        DateTime               @default(now())
  policyVersion    PolicyVersion?         @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  allocations      ResourceAllocation[]
  decisions        OptimizationDecision[]

  @@index([algorithm])
  @@index([policyVersionId])
  @@map("optimization_runs")
}

/// Giải trình chi tiết từng quyết định phân bổ trong không gian Pareto (Decision Provenance)
model OptimizationDecision {
  id               String          @id @default(uuid())
  runId            String
  allocationId     String?
  objectiveVector  Json            @default("[]") // [waitingTime, energyCost, degradation, fairness]
  paretoRank       Int             @default(1)
  crowdingDistance Float           @default(0)
  explanation      String?
  createdAt        DateTime        @default(now())
  optimizationRun  OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("optimization_decisions")
}

// ─────────────────────────────────────────
// BEHAVIORAL REPUTATION SCORE (Phase 2)
// ─────────────────────────────────────────

/// Điểm uy tín hành vi người dùng (0-100), độc lập với BasePriority
model UserBehaviorScore {
  id               String             @id @default(uuid())
  userId           String             @unique
  currentScore     Float              @default(100.0) // Thang 0.0 - 100.0
  lateCancelCount  Int                @default(0)
  noShowCount      Int                @default(0)
  quotaBreachCount Int                @default(0)
  cleanStreakDays  Int                @default(0)
  lastViolationAt  DateTime?
  updatedAt        DateTime           @default(now()) @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             BehaviorEventLog[]

  @@index([userId])
  @@map("user_behavior_scores")
}

/// Nhật ký chi tiết các sự kiện thưởng/phạt điểm uy tín
model BehaviorEventLog {
  id            String            @id @default(uuid())
  scoreId       String
  eventType     String            // LATE_CANCEL | NO_SHOW | QUOTA_BREACH | CLEAN_STREAK_RECOVERY
  scoreDelta    Float             // Ví dụ: -10.0, -25.0, +2.0
  previousScore Float
  newScore      Float
  reason        String
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now())
  score         UserBehaviorScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId, createdAt])
  @@map("behavior_event_logs")
}


