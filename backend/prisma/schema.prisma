generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS (SMART BOOKING & ADVISORY 2026)
// ─────────────────────────────────────────

enum Role {
  ADMIN
  INSTRUCTOR
  RESEARCHER
  STUDENT
  admin
  student
}

enum ResourceCategory {
  GPU_CLUSTER
  LAB_ROOM
  MEETING_ROOM
  EDGE_KIT
}

enum ResourceStatus {
  AVAILABLE
  BUSY
  MAINTENANCE
  available
  maintenance
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  pending
  confirmed
  cancelled
}

enum TransactionStatus {
  PENDING
  SUCCESS
  EXPIRED
  REFUNDED
}

// ─────────────────────────────────────────
// CORE 5 MODELS
// ─────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  role               Role      @default(STUDENT)
  monthlyQuotaHours  Float     @default(40.0) @map("monthly_quota_hours")
  usedQuotaHours     Float     @default(0.0) @map("used_quota_hours")
  reputationScore    Int       @default(100) @map("reputation_score")
  studentId          String?   @map("student_id")
  department         String?
  phone              String?
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  bookings           Booking[]

  @@map("users")
}

model Resource {
  id                 String             @id
  name               String
  category           ResourceCategory   @default(GPU_CLUSTER)
  hourlyRateVnd      Int                @map("hourly_rate_vnd")
  capacity           Int                @default(1)
  location           String?
  status             ResourceStatus     @default(AVAILABLE)
  specsJson          Json?              @map("specs_json")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  bookings           Booking[]
  efficiencyMetrics  AiEfficiencyMetric[]

  @@map("resources")
}

model Booking {
  id                 String              @id @default(cuid())
  resourceId         String              @map("resource_id")
  userId             String              @map("user_id")
  title              String
  startTime          DateTime            @map("start_time")
  endTime            DateTime            @map("end_time")
  status             BookingStatus       @default(PENDING_PAYMENT)
  totalPriceVnd      Int                 @map("total_price_vnd")
  checkinCode        String              @map("checkin_code")
  checkinAt          DateTime?           @map("checkin_at")
  attendeesCount     Int                 @default(1) @map("attendees_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  resource           Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       VietQrTransaction[]

  @@index([resourceId, startTime, endTime])
  @@index([userId])
  @@map("bookings")
}

model VietQrTransaction {
  id                 String            @id @default(cuid())
  bookingId          String            @map("booking_id")
  amountVnd          Int               @map("amount_vnd")
  paymentContent     String            @unique @map("payment_content")
  bankCode           String            @default("MBBank") @map("bank_code")
  accountNumber      String            @default("99882826888") @map("account_number")
  status             TransactionStatus @default(PENDING)
  paidAt             DateTime?         @map("paid_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  booking            Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("vietqr_transactions")
}

model AiEfficiencyMetric {
  id                 String    @id @default(cuid())
  date               DateTime
  resourceId         String    @map("resource_id")
  utilizationRate    Float     @map("utilization_rate")
  idleHoursSaved     Float     @map("idle_hours_saved")
  carbonOffsetKg     Float     @map("carbon_offset_kg")
  createdAt          DateTime  @default(now()) @map("created_at")

  resource           Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, date])
  @@map("ai_efficiency_metrics")
}
