{
  "name": "lab-resource-manager-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:guard": "node prisma/applyBookingGuard.js",
    "db:deploy": "prisma migrate deploy && node prisma/seedAdmin.js",
    "db:seed:admin": "node prisma/seedAdmin.js",
    "import:resources": "node scripts/importResources.js",
    "db:seed": "node prisma/seedBookingPlatform.js",
    "test": "npm run test:required",
    "test:core": "node --test test/bookingOverlap.test.js test/dataContract.test.js test/batch1e/bookingStateMachine.test.js test/batch1e/dataContract.test.js test/batch1e/errors.test.js test/batch1e/labScope.test.js test/batch1e/mockSafety.test.js test/batch1e/roleConstants.test.js",
    "test:batch2": "node --test test/batch2.auth-rbac.integration.test.js",
    "test:batch3": "node --test test/batch3.resource-management.integration.test.js",
    "test:batch4": "node --test test/batch4/bookingPolicy.test.js test/batch4.booking-calendar.integration.test.js",
    "test:all": "node --test",
    "test:batch5": "node --test test/batch5.operational-workflow.integration.test.js",
    "test:batch6": "node --test test/batch6.notifications-incidents-dashboard.integration.test.js",
    "lint": "npx --yes eslint@9.17.0 \"src/**/*.js\" \"prisma/*.js\" \"scripts/**/*.mjs\"",
    "verify:prod-config": "node scripts/verifyProductionConfig.mjs",
    "demo:seed-infrastructure": "node scripts/seedGraduationDemoInfrastructure.mjs",
    "test:required": "npm run test:core",
    "test:research": "node --test test/concurrency.test.js test/conflictForecasting.test.js test/geneticScheduler.test.js test/hybridDispatch.test.js test/integrations.test.js test/mqttTelemetry.test.js test/multiObjectiveAndBenchmark.test.js test/optimization.test.js test/orchestrationV2.test.js test/reputationScore.test.js test/services.test.js test/smartBookingPlatform.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "openai": "^6.49.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  }
}
