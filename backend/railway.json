{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "preDeployCommand": ["npm run db:deploy"],
    "startCommand": "npm run start:prod",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1
  }
}
