POSTGRES_DB=lab_resources
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
CORS_ORIGINS=https://your-domain.example
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
APP_PORT=80
PROMETHEUS_PORT=9090
# Optional observability profile: use the same random token in the backend and file.
METRICS_TOKEN=
METRICS_TOKEN_FILE=./.secrets/metrics-token
VITE_APP_NAME=Quản lý phòng thí nghiệm
VITE_APP_SUBTITLE=Đặt lịch và vận hành thiết bị
REMINDER_SCHEDULER_ENABLED=true
BOOKING_UPCOMING_REMINDER_MINUTES=60
RETURN_REMINDER_MINUTES=15
LRM_LOG_FORMAT=combined
VITE_ENABLE_RESEARCH_FEATURES=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
PAYMENTS_ENABLED=false
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://api.your-domain.example/api/payments/vnpay/return
VNPAY_IPN_URL=https://api.your-domain.example/api/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
PAYMENT_APP_URL=https://your-domain.example
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_EXTERNAL_HOSTS=upload.wikimedia.org,commons.wikimedia.org

# Authenticated read-only assistant; external generation is optional.
MCP_ASSISTANT_ENABLED=true
VITE_ENABLE_AI_ASSISTANT=true
ASSISTANT_MAX_CONCURRENT=4
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_TOOL_TIMEOUT_MS=10000
ASSISTANT_RATE_LIMIT_PER_MINUTE=6
ASSISTANT_MODEL_FAILURE_THRESHOLD=3
ASSISTANT_MODEL_COOLDOWN_MS=30000
# Hardware UI remains deferred. Payment UI follows the separate payment setup.
VITE_ENABLE_TELEMETRY_FEATURES=false
HARDWARE_TELEMETRY_ENABLED=false
VITE_ENABLE_PAYMENT_FEATURES=false
