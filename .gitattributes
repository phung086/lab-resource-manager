# Keep migration checkout bytes deterministic across platforms. Ordinary
# Prisma migration deployment is the verified production path; historical SQL
# and _prisma_migrations remain immutable.
backend/prisma/migrations/**/migration.sql text eol=crlf
backend/prisma/baseline/**/migration.sql text eol=lf

# Keep application source and documentation portable and deterministic.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
