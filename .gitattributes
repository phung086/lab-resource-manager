# Keep migration checkout bytes deterministic across platforms. Historical
# Batch 1 checksum snapshots predate the current repository materialization;
# the canonical deployment bridge handles that known reconciliation without
# editing tracked migration SQL or _prisma_migrations manually.
backend/prisma/migrations/**/migration.sql text eol=crlf

# Keep application source and documentation portable and deterministic.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
