# Historical migration checksums were verified from the original Windows workspace.
# Materialize migration SQL with CRLF on every platform so Prisma sees the same bytes.
backend/prisma/migrations/**/migration.sql text eol=crlf

# Keep application source and documentation portable and deterministic.
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
