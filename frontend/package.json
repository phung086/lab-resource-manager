{
  "name": "lab-resource-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "media:prepare": "node scripts/prepareMedia.mjs",
    "media:smoke": "node scripts/checkMediaDelivery.mjs",
    "test:media": "node --experimental-strip-types --test test_media_delivery.mjs test_media_preparation.mjs",
    "test:ui:calendar-planner": "node test_calendar_planner_ui.mjs",
    "test:calendar-planner": "node --experimental-strip-types --test test_calendar_planner.mjs",
    "test:ui:contrast": "node test_ui_contrast.mjs",
    "test:ui:payment-hold": "node test_payment_hold_ui.mjs",
    "test:ui:fulfillment": "node test_fulfillment_ui.mjs",
    "dev": "node scripts/dev-local.mjs",
    "dev:demo": "node scripts/dev-local.mjs --demo",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:stop": "node scripts/dev-local.mjs --stop",
    "dev:main": "node scripts/dev-local.mjs --main",
    "dev:main:stop": "node scripts/dev-local.mjs --main --stop",
    "build": "vite build && node scripts/prepareSeo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:ui:dossier": "node test_resource_dossier_ui.mjs",
    "test:ui:catalogue": "node test_resource_catalogue_ui.mjs",
    "test:e2e:auth": "node test_batch2_auth_e2e.mjs",
    "test:e2e:resources": "node test_batch3_resources_e2e.mjs",
    "test:e2e:calendar": "node test_batch4_calendar_e2e.mjs",
    "test:e2e:operations": "node test_batch5_operations_e2e.mjs",
    "test:e2e:monitoring": "node test_batch6_monitoring_e2e.mjs",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:required": "npm run test:routes && npm run test:auth && npm run test:accounts && npm run test:payments && npm run test:chatgpt-bridge && npm run test:calendar-planner && npm run test:planning-ui && npm run test:media && npm run test:i18n && npm run lint && npm run typecheck && npm run build",
    "test:payments": "node --experimental-strip-types --test test_payment_validation.mjs",
    "test:phase-g": "node --experimental-strip-types test_timezone_vietnam.mjs && node --experimental-strip-types test_guest_booking_wizard.mjs && node test_eligibility_and_temp_account.mjs",
    "test:e2e:phase-h": "node test_phase_h_payment_e2e.mjs",
    "test:e2e:demo": "node test_batch7_graduation_demo_e2e.mjs",
    "test:e2e:smart-monitoring": "node test_batch8_smart_monitoring_e2e.mjs",
    "test:ui:workspace": "node test_workspace_navigation_ui.mjs",
    "i18n:sync": "node scripts/syncLocales.mjs --write",
    "test:i18n": "node scripts/syncLocales.mjs && node scripts/auditLocaleSource.mjs && node --test test_locale_loader.mjs test_api_request.mjs test_locale_sync.mjs",
    "test:ui:bilingual": "node test_bilingual_workspace_ui.mjs",
    "test:ui:roles": "node test_role_workspaces_ui.mjs",
    "test:ui:queue-pagination": "node test_queue_pagination_ui.mjs",
    "dev:backend": "node scripts/dev-local.mjs --backend",
    "dev:backend:rebuild": "node scripts/dev-local.mjs --backend --rebuild",
    "test:auth": "node --test test_auth_validation.mjs test_security_seo.mjs",
    "test:routes": "node --test test_workspace_routes.mjs",
    "test:ui:support": "node test_support_ui.mjs",
    "test:ui:assistant-experience": "node test_assistant_experience_ui.mjs",
    "test:ui:assistant-roles": "node test_assistant_roles_ui.mjs",
    "test:accounts": "node --experimental-strip-types --test test_account_security_validation.mjs test_profile_validation.mjs test_profile_activity.mjs",
    "test:ui:accounts": "node test_account_security_ui.mjs",
    "test:chatgpt-bridge": "node --experimental-strip-types --test test_chatgpt_bridge.mjs",
    "test:planning-ui": "node --experimental-strip-types --test test_planning_presentation.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.5",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.7"
  }
}
